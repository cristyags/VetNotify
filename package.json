{
  "name": "vetnotify",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "build": "npm run build:api && npm run build:web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.web.json",
    "doctor": "node scripts/local.mjs doctor",
    "bootstrap-local": "node scripts/bootstrap-local.mjs",
    "up-core": "node scripts/local.mjs core",
    "up-full": "node scripts/local.mjs full",
    "up-obs": "node scripts/local.mjs obs",
    "seed": "node scripts/local.mjs seed",
    "acceptance": "node --env-file-if-exists=.env tests/acceptance/run.mjs",
    "demo-api": "node --env-file-if-exists=.env scripts/demo-api.mjs",
    "demo-ui": "playwright test",
    "verify-no-frontend": "node --env-file-if-exists=.env scripts/no-frontend.mjs",
    "incident": "node --env-file-if-exists=.env scripts/incident.mjs",
    "recover": "node --env-file-if-exists=.env scripts/recover.mjs",
    "evidence": "node scripts/evidence.mjs",
    "agenda": "node --env-file-if-exists=.env dist-api/clients/agenda/index.js",
    "laboratorio": "node --env-file-if-exists=.env dist-api/clients/laboratorio/index.js",
    "rollback-demo": "node --env-file-if-exists=.env scripts/rollback.mjs",
    "infra-plan": "pwsh -NoProfile -File scripts/cloud.ps1 -Action plan",
    "infra-apply": "pwsh -NoProfile -File scripts/cloud.ps1 -Action apply",
    "cloud-status": "pwsh -NoProfile -File scripts/cloud.ps1 -Action status",
    "cloud-start": "pwsh -NoProfile -File scripts/cloud.ps1 -Action start",
    "cloud-stop": "pwsh -NoProfile -File scripts/cloud.ps1 -Action stop",
    "cloud-destroy": "pwsh -NoProfile -File scripts/cloud.ps1 -Action destroy",
    "test:ttl": "node --env-file-if-exists=.env scripts/ttl-test.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-typebox": "5.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.8",
    "lucide-react": "0.577.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
