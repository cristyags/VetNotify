{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "module": "ESNext", "moduleResolution": "Bundler", "noEmit": true, "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["apps/web/src", "vite.config.ts"]
}
