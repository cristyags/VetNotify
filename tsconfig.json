{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist-api", "strict": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "resolveJsonModule": true
  },
  "include": ["apps/*/src/**/*.ts", "clients/**/*.ts", "packages/**/*.ts", "scripts/*.ts"],
  "exclude": ["apps/web"]
}
